{
  "name": "track-changes",
  "displayName": "Track Changes",
  "description": "%description%",
  "version": "0.5.0",
  "publisher": "rikpan",
  "author": "rikpan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rikpan/TrackChanges.git"
  },
  "bugs": {
    "url": "https://github.com/rikpan/TrackChanges/issues"
  },
  "homepage": "https://github.com/rikpan/TrackChanges#readme",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "track changes",
    "visual studio",
    "gutter",
    "modified lines"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "trackChanges.toggle",
        "title": "%command.toggle%",
        "category": "%category%"
      },
      {
        "command": "trackChanges.reset",
        "title": "%command.reset%",
        "category": "%category%"
      },
      {
        "command": "trackChanges.resetAll",
        "title": "%command.resetAll%",
        "category": "%category%"
      },
      {
        "command": "trackChanges.nextChange",
        "title": "%command.nextChange%",
        "category": "%category%"
      },
      {
        "command": "trackChanges.previousChange",
        "title": "%command.previousChange%",
        "category": "%category%"
      }
    ],
    "keybindings": [
      {
        "command": "trackChanges.nextChange",
        "key": "ctrl+alt+down",
        "mac": "cmd+alt+down",
        "when": "editorTextFocus && config.trackChanges.enabled"
      },
      {
        "command": "trackChanges.previousChange",
        "key": "ctrl+alt+up",
        "mac": "cmd+alt+up",
        "when": "editorTextFocus && config.trackChanges.enabled"
      }
    ],
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "trackChanges.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%config.enabled%"
        },
        "trackChanges.unsavedColor": {
          "type": "string",
          "default": "#EFD700",
          "description": "%config.unsavedColor%"
        },
        "trackChanges.savedColor": {
          "type": "string",
          "default": "#57A64A",
          "description": "%config.savedColor%"
        },
        "trackChanges.revertedColor": {
          "type": "string",
          "default": "#3E8FD8",
          "description": "%config.revertedColor%"
        },
        "trackChanges.markerWidth": {
          "type": "number",
          "default": 3,
          "minimum": 1,
          "maximum": 16,
          "description": "%config.markerWidth%"
        },
        "trackChanges.showInOverviewRuler": {
          "type": "boolean",
          "default": true,
          "description": "%config.showInOverviewRuler%"
        },
        "trackChanges.maxFileLines": {
          "type": "number",
          "default": 100000,
          "minimum": 1,
          "description": "%config.maxFileLines%"
        },
        "trackChanges.debounceMs": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "%config.debounceMs%"
        },
        "trackChanges.language": {
          "type": "string",
          "enum": [
            "auto",
            "en",
            "zh-cn"
          ],
          "enumDescriptions": [
            "%config.language.auto%",
            "%config.language.en%",
            "%config.language.zh-cn%"
          ],
          "default": "auto",
          "description": "%config.language%"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test out/test/tracker.test.js out/test/i18n.test.js",
    "package": "vsce package",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.75.0",
    "@vscode/test-electron": "^3.1.0",
    "typescript": "^5.4.0"
  }
}
